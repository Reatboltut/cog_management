# Local template. Deployment platforms should set production values in their own environment settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=

# Local default: JSON in the workspace data folder.
# SQLite works too, but on Windows it is safer to keep the SQLite file outside synced folders like OneDrive.
STORAGE_PROVIDER=json
APP_DATA_DIR=./data

# Optional explicit overrides.
# For local SQLite on Windows, prefer setting SQLITE_STATE_FILE to a path in LocalAppData and leaving APP_DATA_DIR blank.
# For Docker/Railway/Render with a mounted volume, set STORAGE_PROVIDER=sqlite and APP_DATA_DIR=/app/data.
# JSON_STATE_FILE=./data/app-state.json
# SQLITE_STATE_FILE=C:/Users/<you>/AppData/Local/cog-management-system/app-state.sqlite

# Leave blank to use the same origin by default, or set your deployed frontend origin.
CORS_ORIGIN=

# Maximum JSON request size in bytes
MAX_REQUEST_BODY_BYTES=10485760
